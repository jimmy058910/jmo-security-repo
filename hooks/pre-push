#!/bin/bash
# Pre-push hook: checks that pre-commit doesn't cover
# Install: cp hooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
#
# Checks run here are UNIQUE to pre-push. Black, Ruff, mypy, markdownlint,
# and other code quality checks are handled by pre-commit hooks at commit time.
# See .pre-commit-config.yaml for the full list.

set -e

echo "Running pre-push checks..."

# 1. Check for untracked Python modules in scripts/
untracked=$(git ls-files --others --exclude-standard scripts/ | grep "\.py$" || true)
if [ -n "$untracked" ]; then
  echo "ERROR: Untracked Python files found in scripts/:"
  echo "$untracked"
  echo ""
  echo "Fix: Run 'git add scripts/' before pushing"
  exit 1
fi

# 2. Quick import check for critical modules
echo "  Checking critical Python imports..."
critical_modules=(
  "scripts.core.compliance_frameworks"
  "scripts.core.exceptions"
  "scripts.core.tool_runner"
)

for module in "${critical_modules[@]}"; do
  if ! python -c "import $module" 2>/dev/null; then
    echo "ERROR: Cannot import $module - module missing or broken"
    echo "Fix: Ensure all Python modules in scripts/ are committed and functional"
    exit 1
  fi
done

# Lockfile freshness is NOT checked here. It used to be (comparing
# requirements-dev.in against requirements-dev.txt), but the `uv-lock`
# pre-commit hook now runs `uv lock --check` at commit time, which is strictly
# earlier and non-interactive. This hook keeps only checks that pre-commit
# cannot do.

echo "Pre-push checks passed!"
